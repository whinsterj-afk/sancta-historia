# Supabase — obtenha em https://supabase.com/dashboard/project/<seu-projeto>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>

# MapTiler — crie uma chave em https://cloud.maptiler.com → Keys
# Restrinja o domínio permitido no painel do MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=<sua-chave-aqui>
