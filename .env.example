# Supabase — obtenha em https://supabase.com/dashboard/project/<seu-projeto>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>

# Mapbox GL — crie um token em https://account.mapbox.com → Access tokens
# Free tier: 50.000 carregamentos de mapa por mês
NEXT_PUBLIC_MAPBOX_TOKEN=pk.<seu-token-aqui>
